# ============================================================
# Fleet Analysis System — Environment Variables Template
# העתק לקובץ .env ומלא את הערכים האמיתיים. אל תעלה .env ל-git.
# ============================================================

# --- זהות ארגונית ---
COMPANY_NAME=G1 Group
COMPANY_TIMEZONE=Asia/Jerusalem
COMPANY_LOCALE=he-IL
COMPANY_CURRENCY=ILS

# --- נתיבי עבודה (יחסיים לשורש הפרויקט) ---
INPUT_DIR=input
OUTPUT_DIR=output
ARCHIVE_DIR=output/archive
REFERENCES_DIR=references

# --- ברירות מחדל לסוכנים ---
DEFAULT_PERIOD=quarterly         # quarterly | monthly | annual
DEFAULT_CUT_LEVEL=group          # group | division | branch
DEFAULT_LANGUAGE=he              # he | en
DEFAULT_FONT=Tahoma
DEFAULT_FONT_SIZE=11

# --- ספים לחריגים (לזיהוי אוטומטי על ידי גל) ---
ANOMALY_FUEL_COST_PCT=50         # קפיצה % שמעליה זה חריג
ANOMALY_KM_PER_LITER_MIN=3       # תחת זה — חריג שלילי
ANOMALY_KM_PER_LITER_MAX=30      # מעל זה — חריג חיובי / טעות
UTILIZATION_LOW_THRESHOLD=0.5    # מתחת — תת-ניצול
UTILIZATION_HIGH_THRESHOLD=1.5   # מעל — ניצול-יתר

# --- מפתחות API (אופציונלי, אם הסוכנים יופעלו פרוגרמטית מחוץ ל-Claude Code) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- תוויות הפצה (לברק) ---
INTERNAL_WATERMARK=פנימי בלבד — G1 Group
CONFIDENTIAL_WATERMARK=חסוי — אין להפיץ

# --- אישור הפצה חיצונית (חובה לעבור True כדי שברק יפיק PDF להפצה חיצונית) ---
EXTERNAL_DISTRIBUTION_APPROVED=false
